# Policy detections for cleartext credentials
# SID range: 1000400-1000499

alert tcp $HOME_NET any -> $EXTERNAL_NET 21 (msg:"POLICY FTP control channel observed"; flow:to_server,established; sid:1000401; rev:1; classtype:policy-violation; metadata:created_at 2026_06_23, protocol ftp;)

alert tcp $HOME_NET any -> $EXTERNAL_NET $HTTP_PORTS (msg:"POLICY possible password parameter over HTTP"; flow:to_server,established; http_client_body; content:"password="; nocase; sid:1000402; rev:1; classtype:policy-violation; metadata:created_at 2026_06_23;)

alert tcp $HOME_NET any -> $EXTERNAL_NET 23 (msg:"POLICY Telnet connection observed"; flow:to_server,established; sid:1000403; rev:1; classtype:policy-violation; metadata:created_at 2026_06_23, protocol telnet;)
