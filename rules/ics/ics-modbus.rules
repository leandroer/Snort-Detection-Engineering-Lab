# ICS / Modbus monitoring examples
# SID range: 1000500-1000599
# Validate carefully before use in production OT environments.

alert tcp $EXTERNAL_NET any -> $HOME_NET 502 (msg:"ICS Modbus traffic from external network"; flow:to_server,established; sid:1000501; rev:1; classtype:protocol-command-decode; metadata:created_at 2026_06_23, protocol modbus;)

alert tcp any any -> $HOME_NET 502 (msg:"ICS Modbus write function code observed"; flow:to_server,established; content:"|00 00|"; offset:0; depth:2; sid:1000502; rev:1; classtype:protocol-command-decode; metadata:created_at 2026_06_23, protocol modbus;)
