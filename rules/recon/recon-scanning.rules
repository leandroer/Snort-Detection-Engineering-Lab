# Reconnaissance and scanning rules
# SID range: 1000300-1000399

alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"RECON TCP SYN scan threshold"; flags:S; detection_filter:track by_src, count 50, seconds 10; sid:1000301; rev:1; classtype:attempted-recon; metadata:created_at 2026_06_23;)

alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"RECON SSH connection attempt threshold"; flags:S; detection_filter:track by_src, count 10, seconds 60; sid:1000302; rev:1; classtype:attempted-recon; metadata:created_at 2026_06_23;)

alert tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"RECON common admin path probing"; flow:to_server,established; http_uri; content:"/admin"; nocase; detection_filter:track by_src, count 10, seconds 60; sid:1000303; rev:1; classtype:web-application-activity; metadata:created_at 2026_06_23;)
