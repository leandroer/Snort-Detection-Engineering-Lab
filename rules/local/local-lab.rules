# Local lab rules
# SID range: 1000000-1000099

alert icmp any any -> $HOME_NET any (msg:"LAB ICMP ping detected"; itype:8; sid:1000001; rev:1; classtype:misc-activity; metadata:created_at 2026_06_23, deployment lab;)

alert tcp any any -> $HOME_NET 80 (msg:"LAB HTTP request to test path"; flow:to_server,established; http_uri; content:"/snort-test"; nocase; sid:1000002; rev:1; classtype:web-application-activity; metadata:created_at 2026_06_23, deployment lab;)
